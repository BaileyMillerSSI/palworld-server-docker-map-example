# Collector-to-Palworld connection. The REST API remains private to the Compose network.
PalworldApi__BaseUrl=http://palworld:8212
PalworldApi__Admin__Username=admin
PalworldApi__Admin__Password=REPLACE_WITH_PALWORLD_ADMIN_PASSWORD

# Collector-to-Palmap connection. Admin labels the client ID as the Server/Client ID.
PalmapIngest__Endpoint=http://192.168.1.6:5080/api/ingest/v1/snapshots
PalmapIngest__ClientId=REPLACE_WITH_PALMAP_CLIENT_ID
PalmapIngest__ClientSecret=REPLACE_WITH_PALMAP_CLIENT_SECRET
PalmapIngest__PrivacyKey=REPLACE_WITH_32_BYTE_BASE64_PRIVACY_KEY

# Plain HTTP is allowed only for this explicit Development LAN configuration.
DOTNET_ENVIRONMENT=Development
PalmapIngest__AllowInsecureHttp=true
